# Vercel server-side environment variables. Configure in Vercel Settings.
# Never prefix these credentials with VITE_ or commit real values.
HUEART_BACKEND_URL=
HUEART_BACKEND_SERVICE_TOKEN=
HUEART_BACKEND_BRIDGE_TOKEN=
# Optional comma-separated hostnames for custom domains.
HUEART_PUBLIC_HOSTS=

# Backend Sites secrets; configure through Sites, not in Vercel frontend.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
VERCEL_BRIDGE_TOKEN=
# Optional server-side Gemini key for live AI curation.
GEMINI_API_KEY=
